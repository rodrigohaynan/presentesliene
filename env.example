# Senha do administrador: acesso completo, inclusive identidade de quem escolheu cada presente.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Senha do aniversariante: pode gerenciar festa, convidados e presentes,
# mas o servidor NÃO entrega os nomes/contatos de quem reservou presentes.
ANIVERSARIANTE_PASSWORD=troque-por-outra-senha-forte
